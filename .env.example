# Salin ke .env. Mode mock tidak membutuhkan key atau jaringan LLM.
LLM_PROVIDER=mock
# Isi nama model yang tersedia di akun/provider Anda saat memakai provider nyata.
LLM_MODEL_FAST=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=90

# make dev menjalankan Redis sendiri pada port ini; Docker menimpa REDIS_URL.
REDIS_URL=redis://127.0.0.1:6386/0
DATA_DIR=./data
API_INTERNAL_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:3000
JOB_TIMEOUT_SECONDS=7200
MAX_UPLOAD_BYTES=4294967296
MAX_SOURCE_SECONDS=10800

# Pustaka dan bobot Whisper hanya diperlukan untuk video nyata tanpa sidecar transkrip.
# auto: mlx-whisper di Apple Silicon bila terpasang, faster-whisper pada platform lain.
TRANSCRIPTION_BACKEND=auto
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Checkpoint setelah setiap bagian selesai; retry hanya mengulang bagian yang belum selesai.
WHISPER_CHUNK_SECONDS=60
MAINTENANCE_INTERVAL_SECONDS=15
# Pembaruan yt-dlp terisolasi di data/tools; tidak mengubah uv.lock/virtualenv aplikasi.
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_TIMEZONE=Asia/Jakarta

# Batas tinggi ekspor. Otomatis mempertahankan orientasi dan tidak memperbesar sumber kecil.
# Tes memakai 320; 1280 memberi ruang yang cukup untuk caption singkat dan detail sumber.
RENDER_HEIGHT=1280
# Salinan source.mp4 yang tidak dipakai selama ini dibersihkan; unggahan asli/transkrip/hasil tetap ada.
SOURCE_CACHE_DAYS=14
RENDER_THREADS=4
